logging {
  level = "warn"
}
loki.write "observer" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
loki.source.syslog "proxmox" {
  listener {
    address = "192.168.150.21:5514"
    protocol = "udp"
    syslog_format = "rfc3164"
    labels = { job = "firewall", firewall = "proxmox" }
  }
  forward_to = [loki.write.observer.receiver]
}
loki.source.syslog "pfsense" {
  listener {
    address = "192.168.150.21:5515"
    protocol = "udp"
    syslog_format = "rfc3164"
    labels = { job = "firewall", firewall = "pfsense" }
  }
  forward_to = [loki.write.observer.receiver]
}
