      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"firewall\",firewall=\"pfsense\"} | regexp \"^(?:[^,]*,){4}(?P<iface>[^,]+),[^,]*,(?P<action>block|pass),[^,]*,4,(?:[^,]*,){7}(?P<proto>tcp|udp),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+),(?P<spt>[0-9]+),(?P<dpt>[0-9]+)(?:,|$)\" | __error__=\"\" | iface=~\".+\" | iface=~\"${pf_iface:raw}\" | action=~\"${pf_action:raw}\" | proto=~\"${pf_proto:raw}\" | src=~\"${pf_src:raw}\" | dst=~\"${pf_dst:raw}\" | dpt=~\"${pf_dpt:raw}\" | line_format \"{{ if eq .action \\\"block\\\" }}BLOCK{{ else }}PASS{{ end }} | {{ if eq .iface \\\"em0\\\" }}WAN{{ else if eq .iface \\\"em1\\\" }}LAN{{ else }}{{ .iface }}{{ end }} | {{.src}} -> {{.dst}}:{{.dpt}} | {{ if eq .proto \\\"tcp\\\" }}TCP{{ else }}UDP{{ end }}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
