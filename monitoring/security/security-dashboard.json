    {
      "id": 11,
      "title": "pfSense · Sự kiện theo bộ lọc (5 phút)",
      "type": "stat",
      "description": "Đếm filterlog IPv4 TCP/UDP khớp các bộ lọc ở đầu dashboard (Action mặc định Block). Không bao gồm IPv6, IGMP, ICMP hoặc các sự kiện không có cổng.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 7,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"pfsense\"} | regexp \"^(?:[^,]*,){4}(?P<iface>[^,]+),[^,]*,(?P<action>block|pass),[^,]*,4,(?:[^,]*,){7}(?P<proto>tcp|udp),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+),(?P<spt>[0-9]+),(?P<dpt>[0-9]+)(?:,|$)\" | __error__=\"\" | iface=~\".+\" | iface=~\"${pf_iface:raw}\" | action=~\"${pf_action:raw}\" | proto=~\"${pf_proto:raw}\" | src=~\"${pf_src:raw}\" | dst=~\"${pf_dst:raw}\" | dpt=~\"${pf_dpt:raw}\" [5m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
