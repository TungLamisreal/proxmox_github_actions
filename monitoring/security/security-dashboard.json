{
  "uid": "meow-security",
  "title": "MeowCloud · Firewall Monitoring",
  "description": "Unified Proxmox and pfSense firewall monitoring: preserve the existing Proxmox DROP dashboard, with pfSense events immediately below for scrolling during the lab demo.",
  "tags": [
    "meowcloud",
    "security",
    "firewall"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 4,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Tổng kết nối bị chặn · 5 phút",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 7,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" [5m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Số kết nối bị chặn theo thời gian",
      "type": "timeseries",
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 17,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" [1m]))",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Nhật ký chặn kết nối · Nguồn → Đích:Cổng",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" | regexp \"SRC=(?P<src>[^ ]+) DST=(?P<dst>[^ ]+).*PROTO=(?P<proto>[^ ]+).*DPT=(?P<dpt>[0-9]+)\" | __error__=\"\" | line_format \"DROP | {{.src}} -> {{.dst}}:{{.dpt}} | {{.proto}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Hiển thị các sự kiện Proxmox Firewall DROP có IP nguồn, IP đích và cổng đích. Không thay đổi nội dung gốc được lưu trong Loki."
    },
    {
      "id": 5,
      "title": "Top IP nguồn bị chặn · 5 phút",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (src) (count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" | regexp \"SRC=(?P<src>[0-9.]+)\" | __error__=\"\" [5m])))",
          "queryType": "instant",
          "legendFormat": "{{src}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "showLegend": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Top cổng đích bị chặn · 5 phút",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (dpt) (count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" | regexp \"DPT=(?P<dpt>[0-9]+)\" | __error__=\"\" [5m])))",
          "queryType": "instant",
          "legendFormat": "{{dpt}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "showLegend": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "pfSense Firewall · Gateway 192.168.150.1",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "pfSense · Kết nối BLOCK (5 phút)",
      "type": "stat",
      "description": "Đếm sự kiện filterlog action=block; cần bật Remote Logging trên pfSense đến 192.168.150.21:5515.",
      "gridPos": {
