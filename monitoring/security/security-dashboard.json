{
  "uid": "meow-security",
  "title": "MeowCloud · Firewall Monitoring",
  "description": "Unified firewall monitoring for Proxmox and pfSense, with expandable sections and searchable IPv4 TCP/UDP firewall event logs.",
  "tags": [
    "meowcloud",
    "security",
    "firewall"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 7,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 3,
      "type": "row",
      "title": "Proxmox Firewall",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Blocked Connections · Last 5 Minutes",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 7,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" [5m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Blocked Connections Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 7,
        "y": 1,
        "w": 17,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" [1m]))",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Firewall Logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" | regexp \"SRC=(?P<src>[^ ]+) DST=(?P<dst>[^ ]+).*PROTO=(?P<proto>[^ ]+).*DPT=(?P<dpt>[0-9]+)\" | __error__=\"\" | line_format \"DROP | {{.src}} -> {{.dst}}:{{.dpt}} | {{.proto}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Displays Proxmox Firewall DROP events with source IP, destination IP and destination port. Original log records remain unchanged in Loki."
    },
    {
      "id": 5,
      "title": "Top Blocked Source IPs · Last 5 Minutes",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (src) (count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" | regexp \"SRC=(?P<src>[0-9.]+)\" | __error__=\"\" [5m])))",
          "queryType": "instant",
          "legendFormat": "{{src}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "showLegend": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Top Blocked Destination Ports · Last 5 Minutes",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
