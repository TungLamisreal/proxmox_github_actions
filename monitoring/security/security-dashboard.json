    {
      "id": 10,
      "type": "row",
      "title": "pfSense Firewall",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "pfSense · Filtered Events · Last 5 Minutes",
      "type": "stat",
      "description": "Counts IPv4 TCP/UDP filterlog events matching the dashboard filters (Block by default). IPv6, IGMP, ICMP and events without destination ports are excluded.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 7,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"pfsense\"} | regexp \"^(?:[^,]*,){4}(?P<iface>[^,]+),[^,]*,(?P<action>block|pass),[^,]*,4,(?:[^,]*,){7}(?P<proto>tcp|udp),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+),(?P<spt>[0-9]+),(?P<dpt>[0-9]+)(?:,|$)\" | __error__=\"\" | iface=~\".+\" | iface=~\"${pf_iface:raw}\" | action=~\"${pf_action:raw}\" | proto=~\"${pf_proto:raw}\" | src=~\"${pf_src:raw}\" | dst=~\"${pf_dst:raw}\" | dpt=~\"${pf_dpt:raw}\" [5m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "pfSense · Events Over Time",
      "type": "timeseries",
      "description": "Shows filtered pfSense IPv4 TCP/UDP events (Block by default).",
      "gridPos": {
        "x": 7,
        "y": 30,
        "w": 17,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"pfsense\"} | regexp \"^(?:[^,]*,){4}(?P<iface>[^,]+),[^,]*,(?P<action>block|pass),[^,]*,4,(?:[^,]*,){7}(?P<proto>tcp|udp),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+),(?P<spt>[0-9]+),(?P<dpt>[0-9]+)(?:,|$)\" | __error__=\"\" | iface=~\".+\" | iface=~\"${pf_iface:raw}\" | action=~\"${pf_action:raw}\" | proto=~\"${pf_proto:raw}\" | src=~\"${pf_src:raw}\" | dst=~\"${pf_dst:raw}\" | dpt=~\"${pf_dpt:raw}\" [1m]))",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Firewall Logs",
      "type": "logs",
      "description": "Displays normalized pfSense IPv4 TCP/UDP events matching the filters above. The original log records remain unchanged in Loki.",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
