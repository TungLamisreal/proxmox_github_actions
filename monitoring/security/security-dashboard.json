  "templating": {
    "list": [
      {
        "name": "pf_iface",
        "label": "pfSense · Interface",
        "type": "custom",
        "hide": 0,
        "query": "WAN : em0, LAN : em1",
        "skipUrlSync": false,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "text": "All",
            "value": ".*",
            "selected": true
          },
          {
            "text": "WAN",
