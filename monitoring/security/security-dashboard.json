{
  "uid": "meow-security",
  "title": "MeowCloud Security Monitoring",
  "description": "Human-readable Proxmox DROP logs with raw evidence and pfSense raw logs; independent of existing Autoscaling dashboard",
  "tags": [
    "meowcloud",
    "security",
    "firewall"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Proxmox · DROP (5 phút)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" [5m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Proxmox · DROP mỗi phút",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" [1m]))",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "pfSense · sự kiện mỗi phút",
      "type": "timeseries",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"firewall\",firewall=\"pfsense\"} [1m]))",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Proxmox · DROP dễ đọc (TCP có cổng đích)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" | regexp \"SRC=(?P<src>[^ ]+) DST=(?P<dst>[^ ]+).*PROTO=(?P<proto>[^ ]+).*DPT=(?P<dpt>[0-9]+)\" | __error__=\"\" | line_format \"DROP | {{.src}} -> {{.dst}}:{{.dpt}} | {{.proto}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Chỉ hiện bản ghi DROP có SRC, DST, PROTO, DPT. Dùng Proxmox raw logs bên dưới cho ICMP/UDP hoặc bản ghi khác. Dữ liệu gốc trong Loki không bị sửa."
    },
    {
      "id": 5,
      "title": "Top IP nguồn bị DROP · 5 phút",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (src) (count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" | regexp \"SRC=(?P<src>[0-9.]+)\" | __error__=\"\" [5m])))",
          "queryType": "instant",
          "legendFormat": "{{src}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "showLegend": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Top cổng đích bị DROP · 5 phút",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (dpt) (count_over_time({job=\"firewall\",firewall=\"proxmox\"} |= \"policy DROP:\" | regexp \"DPT=(?P<dpt>[0-9]+)\" | __error__=\"\" [5m])))",
          "queryType": "instant",
          "legendFormat": "{{dpt}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "showLegend": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Proxmox · log gốc (mọi sự kiện)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"firewall\",firewall=\"proxmox\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Giữ nguyên log gốc cho kiểm chứng, kể cả bản ghi không có DPT."
    },
    {
      "id": 8,
      "title": "pfSense · log gốc",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "meow-security-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"firewall\",firewall=\"pfsense\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Chưa chuẩn hóa pfSense cho đến khi có mẫu filterlog thật từ hệ thống."
    }
  ]
}
