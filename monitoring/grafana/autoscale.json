{
  "uid": "meow-autoscale",
  "title": "MeowCloud · Autoscale",
  "schemaVersion": 39,
  "editable": false,
  "tags": [
    "meowcloud",
    "autoscale"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 4,
      "type": "stat",
      "title": "Alert · PENDING",
      "description": "Số lượng alert autoscale đang PENDING. Dữ liệu lấy trực tiếp từ Prometheus ALERTS; 0 = không có alert. Trạng thái có thể chỉ xuất hiện vài giây trong lúc test tải.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meow-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "meow-prom"
          },
          "expr": "sum(ALERTS{autoscale=\"true\",alertstate=\"pending\"}) or vector(0)",
          "legendFormat": "Alert · PENDING",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
