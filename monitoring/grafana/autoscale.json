    {
      "id": 3,
      "type": "timeseries",
      "title": "Số target trong pool",
      "description": "Tổng target trong cấu hình scrape và số target trả lời. Chênh lệch cho thấy có exporter DOWN.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meow-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "meow-prom"
          },
          "expr": "count by (job) (up{job=~\"lxc_backends|lxc_frontends\"})",
          "legendFormat": "{{job}} tổng",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "meow-prom"
          },
          "expr": "sum by (job) (up{job=~\"lxc_backends|lxc_frontends\"})",
          "legendFormat": "{{job}} UP",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "CPU từng máy · Backend",
      "description": "CPU mỗi Backend = rate(cpu.stat) / vCPU cấp cho LXC × 100. Hiện tự động mọi máy trong inventory sau khi Prometheus cập nhật; 80% là ngưỡng scale-out. Máy mất exporter sẽ không trả CPU: xem panel Targets UP.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meow-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "meow-prom"
          },
          "expr": "100 * sum by (machine) (rate(meowcloud_lxc_cpu_usage_seconds_total{job=\"lxc_backends\"}[1m])) / on(machine) sum by (machine) (meowcloud_lxc_cpu_capacity_cores{job=\"lxc_backends\"})",
          "legendFormat": "{{machine}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 55
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
