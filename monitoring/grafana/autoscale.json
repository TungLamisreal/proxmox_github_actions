{
  "uid": "meow-autoscale",
  "title": "MeowCloud · Autoscale",
  "schemaVersion": 39,
  "editable": false,
  "tags": [
    "meowcloud",
    "autoscale"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 4,
      "type": "meowcloud-alertlog-panel",
      "title": "Alert & nhật ký autoscale",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meow-prom"
      },
      "targets": [
        {
          "refId": "Pending",
          "datasource": {
            "type": "prometheus",
            "uid": "meow-prom"
          },
          "expr": "sum(ALERTS{autoscale=\"true\",alertstate=\"pending\"}) or vector(0)",
          "legendFormat": "Alert · PENDING",
          "instant": true,
          "range": false
        },
        {
          "refId": "Firing",
          "datasource": {
            "type": "prometheus",
            "uid": "meow-prom"
          },
          "expr": "sum(ALERTS{autoscale=\"true\",alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Alert · FIRING",
          "instant": true,
          "range": false
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "CPU từng máy · Backend",
      "description": "CPU theo quota từng LXC. Ngưỡng scale-out CPU pool >75% trong 10s. Máy mất exporter không được coi là 0%.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meow-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "meow-prom"
          },
          "expr": "100 * sum by (machine) (rate(meowcloud_lxc_cpu_usage_seconds_total{job=\"lxc_backends\"}[1m])) / on(machine) sum by (machine) (meowcloud_lxc_cpu_capacity_cores{job=\"lxc_backends\"})",
          "legendFormat": "{{machine}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 55
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          },
          "noValue": "Không có dữ liệu"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "text": {
          "titleSize": 14,
          "valueSize": 20
        },
        "minVizHeight": 10,
        "sizing": "auto"
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "CPU từng máy · Frontend",
      "description": "CPU theo quota từng LXC. Ngưỡng scale-out CPU pool >75% trong 10s. Máy mất exporter không được coi là 0%.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meow-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "meow-prom"
          },
          "expr": "100 * sum by (machine) (rate(meowcloud_lxc_cpu_usage_seconds_total{job=\"lxc_frontends\"}[1m])) / on(machine) sum by (machine) (meowcloud_lxc_cpu_capacity_cores{job=\"lxc_frontends\"})",
          "legendFormat": "{{machine}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 55
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          },
          "noValue": "Không có dữ liệu"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "text": {
          "titleSize": 14,
          "valueSize": 20
        },
        "minVizHeight": 10,
        "sizing": "auto"
      }
    }
  ],
  "description": "Ba khung quay video: Alert + journal webhook, CPU từng Backend, CPU từng Frontend. Log mới nhất trước, cuộn riêng.",
  "version": 1
}
