# ==============================================================================
# 07-ANSIBLE-GENERATOR.TF - TỰ ĐỘNG XUẤT FILE ../ansible/inventory.ini
# ==============================================================================

resource "local_file" "ansible_inventory" {
  # Dùng đường dẫn tương đối để chạy được cả ở máy local và trên GitHub Runner
  filename        = "${path.module}/../ansible/inventory.ini"
  file_permission = "0644"

  content = <<-EOT
    # ==========================================================================
    # MEOWCLOUD DYNAMIC INVENTORY (AUTO-GENERATED BY TERRAFORM)
    # ==========================================================================

    [observer]
    observer ansible_host=192.168.150.21

    [tunnels]
    %{for i in range(3)~}
    tunnel-0${i + 1} ansible_host=192.168.150.${51 + i}
    %{endfor~}

    [loadbalancers]
    lb-01 ansible_host=192.168.150.61 keepalived_state=MASTER keepalived_priority=100
    lb-02 ansible_host=192.168.150.62 keepalived_state=BACKUP keepalived_priority=90

    [backends]
    %{for i in range(var.backend_count)~}
    backend-0${i + 1} ansible_host=192.168.150.${101 + i}
    %{endfor~}

    [frontends]
    %{for i in range(var.frontend_count)~}
    frontend-0${i + 1} ansible_host=192.168.150.${171 + i}
    %{endfor~}

    [databases]
    %{for i in range(var.db_count)~}
    db-0${i + 1} ansible_host=192.168.150.${71 + i} db_role=${i == 0 ? "primary" : "standby"}
    %{endfor~}

    [all:vars]
    ansible_user=root
    ansible_ssh_private_key_file=${var.ssh_private_key_path}
    ansible_python_interpreter=/usr/bin/python3
    # Bỏ qua xác thực fingerprint SSH lần đầu để CI/CD không bị đứng chờ prompt
    ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
  EOT

  # Đảm bảo inventory chỉ được ghi ra sau khi toàn bộ VM và Container đã tạo xong
  depends_on = [
    proxmox_virtual_environment_container.observer,
    proxmox_virtual_environment_container.tunnels,
    proxmox_virtual_environment_container.loadbalancer,
    proxmox_virtual_environment_container.backend,
    proxmox_virtual_environment_container.frontend,
    proxmox_virtual_environment_vm.db
  ]
}
