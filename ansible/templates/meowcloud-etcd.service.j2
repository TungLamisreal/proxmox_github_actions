[Unit]
Description=MeowCloud Database HA Etcd Quorum (DB06 managed)
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=etcd
Group=etcd
ExecStart=/usr/bin/etcd --config-file=/etc/meowcloud/etcd.yml
Restart=on-failure
RestartSec=5
LimitNOFILE=40000
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/meowcloud-etcd

[Install]
WantedBy=multi-user.target
