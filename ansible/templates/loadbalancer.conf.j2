# AUTO-GENERATED BY ANSIBLE - MEOWCLOUD LOAD BALANCER
# Vị trí: ansible/templates/loadbalancer.conf.j2

# Tắt access_log để không bị tràn 4GB disk của LB khi bắn ab tải cao
access_log off;
error_log /var/log/nginx/error.log warn;

upstream meow_frontend {
{% for host in groups['frontends'] %}
    server {{ hostvars[host]['ansible_host'] }}:80 max_fails=2 fail_timeout=5s;
{% endfor %}
    keepalive 32;
}

upstream meow_backend {
{% for host in groups['backends'] %}
    server {{ hostvars[host]['ansible_host'] }}:5000 max_fails=2 fail_timeout=5s;
{% endfor %}
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    # Endpoint kiểm tra trạng thái cho Keepalived và Ansible
    location /lb-status {
        access_log off;
        return 200 "MeowCloud LB Active on {{ inventory_hostname }}\n";
        add_header Content-Type text/plain;
    }

    # ========================================================
    # 1. API BACKEND (Cụm .101+:5000)
    # ========================================================
    location /api/ {
        # Dấu "/" ở cuối giúp Nginx bỏ chữ /api/ khi chuyển tiếp xuống Backend
        proxy_pass http://meow_backend/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Cơ chế Failover tự động bỏ qua node chết
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 5s;

        # Header kiểm chứng node trả lời
        add_header X-Handled-By $upstream_addr always;
    }

    # ========================================================
    # 2. WEB FRONTEND (Cụm .171+:80)
    # ========================================================
    location / {
        proxy_pass http://meow_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Cơ chế Failover tự động bỏ qua node chết
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 5s;

        # Header kiểm chứng node trả lời
        add_header X-Handled-By $upstream_addr always;
    }
}
