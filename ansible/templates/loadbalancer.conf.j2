# AUTO-GENERATED BY ANSIBLE - MEOWCLOUD LOAD BALANCER
upstream meow_frontend {
    least_conn;
    {% for host in groups['frontends'] %}
    server {{ hostvars[host]['ansible_host'] }}:80 max_fails=3 fail_timeout=10s;
    {% endfor %}
}

upstream meow_backend {
    least_conn;
    {% for host in groups['backends'] %}
    server {{ hostvars[host]['ansible_host'] }}:5000 max_fails=3 fail_timeout=10s;
    {% endfor %}
}

server {
    listen 80;
    server_name _;

    location /lb-status {
        access_log off;
        return 200 "MeowCloud LB Active on {{ inventory_hostname }}\n";
        add_header Content-Type text/plain;
    }

    location /api/ {
        proxy_pass http://meow_backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # --- NÂNG CẤP TỰ ĐỘNG CHUYỂN HƯỚNG KHI MÁY CHẾT (FAILOVER) ---
        proxy_connect_timeout 2s;          # Chờ kết nối tối đa 2s, quá 2s coi như nghẽn/chết
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 3;       # Thử tối đa 3 node khác nhau trước khi chịu thua
        proxy_next_upstream_timeout 5s;    # Tổng thời gian thử lại không quá 5s
    }

    location / {
        proxy_pass http://meow_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # --- NÂNG CẤP CHO FRONTEND ---
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 5s;
    }
}
