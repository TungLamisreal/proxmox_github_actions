# AUTO-GENERATED BY ANSIBLE - MEOWCLOUD LOAD BALANCER

upstream meow_frontend {
    least_conn;
{% for host in groups['frontends'] %}
    server {{ hostvars[host]['ansible_host'] }}:80 max_fails=3 fail_timeout=10s;
{% endfor %}
}

upstream meow_backend {
    least_conn;
{% for host in groups['backends'] %}
    server {{ hostvars[host]['ansible_host'] }}:5000 max_fails=3 fail_timeout=10s;
{% endfor %}
}

server {
    listen 80;
    server_name _;

    # Healthcheck endpoint cho Keepalived / Prometheus
    location /lb-status {
        access_log off;
        return 200 "MeowCloud LB Active on {{ inventory_hostname }}\n";
        add_header Content-Type text/plain;
    }

    # Điều phối API xuống khối Đàn hồi Backend (.101 - .170)
    location /api/ {
        proxy_pass http://meow_backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Điều phối Giao diện Web xuống khối Đàn hồi Frontend (.171 - .250)
    location / {
        proxy_pass http://meow_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
