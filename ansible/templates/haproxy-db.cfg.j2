# Writer endpoint. Install separately on LB01 and LB02 only after Patroni
# /primary API is proven correct and the VIP 192.168.150.100 is reachable.
# Include from /etc/haproxy/haproxy.cfg after global/defaults are configured.
frontend meowcloud_postgres_writer
    bind 0.0.0.0:5432
    mode tcp
    default_backend meowcloud_postgres_primary

backend meowcloud_postgres_primary
    mode tcp
    balance first
    option httpchk GET /primary
    http-check expect status 200
    timeout connect 5s
    timeout server 60s
    server db01 192.168.150.71:5432 check port 8008 inter 2s fall 2 rise 2
    server db02 192.168.150.72:5432 check port 8008 inter 2s fall 2 rise 2

