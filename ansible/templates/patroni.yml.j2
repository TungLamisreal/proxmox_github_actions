# Managed by DB07. Render for Patroni-only container AFTER etcd mTLS quorum checks.
# This configuration does not initialize PostgreSQL over an existing PGDATA.
scope: meowcloud-db
namespace: /service/
name: {{ inventory_hostname }}
restapi:
  listen: 0.0.0.0:8008
  connect_address: {{ ansible_host }}:8008
etcd3:
  hosts: "192.168.150.71:2379,192.168.150.72:2379,192.168.150.21:2379"
  protocol: https
  cacert: /etc/meowcloud/tls/ca.pem
  cert: /etc/meowcloud/tls/patroni-client.pem
  key: /etc/meowcloud/tls/patroni-client-key.pem
bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    check_timeline: true
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        wal_log_hints: "on"
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
postgresql:
  listen: 0.0.0.0:5432
  connect_address: {{ ansible_host }}:5432
  data_dir: /var/lib/postgresql/data
  bin_dir: /usr/local/bin
  parameters:
    wal_log_hints: "on"
  authentication:
    superuser:
      username: postgres
      password: {{ vault_postgres_password | to_json }}
    replication:
      username: "{{ pg_replication_user }}"
      password: {{ vault_postgres_replication_password | to_json }}
  pg_hba:
    - "local all postgres trust"
    - "local all all trust"
    - "host all all 127.0.0.1/32 scram-sha-256"
    - "host replication {{ pg_replication_user }} 192.168.150.71/32 scram-sha-256"
    - "host replication {{ pg_replication_user }} 192.168.150.72/32 scram-sha-256"
    - "host all all 192.168.150.0/24 scram-sha-256"
tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false

